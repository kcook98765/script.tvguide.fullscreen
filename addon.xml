<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.tvguide.fullscreen" name="TV Guide Fullscreen"
version="0.0.446~alpha1"
provider-name="primaeval">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.31.0" />
        <import addon="script.module.dateutil" version="2.8.2" />
        <import addon="script.module.pytz" version="2023.3.0+matrix.1" />
        <import addon="script.module.pil" version="5.1.0" />
        <import addon="script.module.beautifulsoup4" version="4.12.2" />
    </requires>
    <extension point="xbmc.python.script" library="addon.py">
            <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Fullscreen TV guide with XMLTV listings.</summary>
        <description lang="en_GB">Possibly the most powerful TV Guide in the world. ;) Thanks for the major contributions from: iainmacleod, im85288, RayW1986, bluezed, andy, Zomboided, tycoo, kjb86, Doctor-Eggs</description>
        <disclaimer lang="en_GB">Based on the original TV Guide addon by twinther, FTV Guide and Midraal's fork.</disclaimer>
        <platform>all</platform>
        <license>GPLv2</license>
        <forum>http://forum.kodi.tv/showthread.php?tid=282157</forum>
        <source>https://github.com/kcook98765/script.tvguide.fullscreen</source>
        <website>https://github.com/primaeval/script.tvguide.fullscreen</website>
        <email>primaeval</email>
        <news>Four-version Alpha: Matrix 19.4, Nexus 20.5, Omega 21.3 and Piers 22 RC2 have bounded aggregate native qualification, with historical component reuse and known limits. Static typing/checker failures remain. Official pytz is required separately; Program and background service are preserved.</news>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
            <screenshot>resources/screenshots/fullscreen-guide.png</screenshot>
            <screenshot>resources/screenshots/programme-actions.png</screenshot>
            <screenshot>resources/screenshots/on-now.png</screenshot>
            <screenshot>resources/screenshots/search-results.png</screenshot>
            <screenshot>resources/screenshots/channel-management.png</screenshot>
        </assets>
    </extension>
</addon>
